{
  "name": "playwright-safe-ui-automation",
  "version": "1.0.0",
  "description": "Portfolio demo: Playwright UI automation with storageState auth, destructive-test gating, and guaranteed cleanup",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:safe": "playwright test --grep-invert @destructive",
    "test:destructive": "cross-env ALLOW_DESTRUCTIVE=1 playwright test --grep @destructive",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
