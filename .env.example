# Copy to .env if you want to override defaults.
# Sauce Demo public credentials are documented on saucedemo.com.

BASE_URL=https://www.saucedemo.com
USERNAME=standard_user
PASSWORD=secret_sauce

# Safety gate for tests tagged @destructive.
# Leave 0 for everyday runs. Set 1 (or use npm run test:destructive) to opt in.
ALLOW_DESTRUCTIVE=0
